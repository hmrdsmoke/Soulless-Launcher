<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.hmrdsmoke.SoullessLauncher</id>
  <name>Soulless Launcher</name>
  <summary>The toolbox you need to organize the tools you use</summary>
  <description>
    <p>
      Soulless is a COSMIC desktop launcher built for Pop!_OS. Find everything 
      on your computer from one place — apps, files, directories, CLI tools, 
      Steam games, Flatpaks, and Snaps. Organize your tools into custom drawers, 
      secure sensitive files behind an encrypted vault, and make it yours with 
      custom backgrounds.
    </p>
    <p>Features:</p>
    <ul>
      <li>Universal search across apps, files, CLI tools, Steam, Flatpak, and Snap</li>
      <li>Custom drawers to organize your apps your way</li>
      <li>Encrypted vault for sensitive files and apps</li>
      <li>Live system monitors — network, CPU, GPU, RAM, FPS</li>
      <li>Custom backgrounds from ~/.config/soulless/backgrounds/</li>
      <li>Instant startup via disk cache</li>
      <li>Keyboard navigation with Tab, S, V, arrow keys</li>
      <li>Super+Space activation from anywhere</li>
      <li>wgpu accelerated rendering</li>
    </ul>
  </description>

  <launchable type="desktop-id">soulless-launcher.desktop</launchable>

  <url type="homepage">https://github.com/hmrdsmoke/Soulless-Launcher</url>
  <url type="bugtracker">https://github.com/hmrdsmoke/Soulless-Launcher/issues</url>

